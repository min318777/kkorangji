<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- 로그 파일 저장 경로 -->
    <property name="LOG_DIR" value="logs"/>

    <!-- ======================== -->
    <!--     콘솔 Appender         -->
    <!--   JSON 구조화 로깅         -->
    <!-- ======================== -->
    <!-- MDC(requestId, userId, clientIp)는 LogstashEncoder가 최상위 필드로 자동 포함 -->
    <!-- 예외 스택트레이스는 stack_trace 필드로 자동 포함 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</timestampPattern>
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <version>[ignore]</version>
                <logger>logger</logger>
                <thread>thread</thread>
                <message>message</message>
                <stackTrace>stack_trace</stackTrace>
            </fieldNames>
        </encoder>
    </appender>

    <!-- ======================== -->
    <!--   파일 롤링 Appender       -->
    <!--   (dev/prod 프로파일)      -->
    <!-- ======================== -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/meow-api.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- 날짜별 롤링: 매일 새 파일 생성 -->
            <fileNamePattern>${LOG_DIR}/meow-api.%d{yyyy-MM-dd}.log</fileNamePattern>
            <!-- 최대 30일치 보관 -->
            <maxHistory>30</maxHistory>
            <!-- 전체 최대 용량 3GB -->
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</timestampPattern>
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <version>[ignore]</version>
                <logger>logger</logger>
                <thread>thread</thread>
                <message>message</message>
                <stackTrace>stack_trace</stackTrace>
            </fieldNames>
        </encoder>
    </appender>

    <!-- ======================== -->
    <!--     프로파일별 설정         -->
    <!-- ======================== -->

    <!-- local 프로파일: 콘솔만 출력, INFO 레벨 -->
    <springProfile name="local">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <!-- 애플리케이션 패키지는 DEBUG 레벨로 상세 출력 -->
        <logger name="com.min.meow" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>
        <!-- SQL 로그: p6spy가 처리하므로 JPA 중복 출력 방지 -->
        <logger name="org.hibernate.SQL" level="OFF"/>
        <logger name="org.hibernate.orm.jdbc.bind" level="OFF"/>
    </springProfile>

    <!-- dev 프로파일: 콘솔 + 파일 출력, DEBUG 레벨 -->
    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
        <!-- 애플리케이션 패키지는 DEBUG 레벨 -->
        <logger name="com.min.meow" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </logger>
    </springProfile>

    <!-- prod 프로파일: 파일만 출력, WARN 레벨 (노이즈 최소화) -->
    <springProfile name="prod">
        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
        <!-- 애플리케이션 패키지는 INFO 레벨 -->
        <logger name="com.min.meow" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </logger>
    </springProfile>

</configuration>
